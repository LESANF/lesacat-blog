{
  "name": "lesacat-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test scripts/blog.test.mjs",
    "media:optimize": "node scripts/optimize-media.mjs",
    "validate": "pnpm lint && pnpm typecheck && pnpm test",
    "doctor": "next info && pnpm lint && pnpm typecheck && pnpm audit",
    "doctor:react": "pnpm dlx react-doctor@0.9.17 . --yes --no-score --no-supply-chain",
    "analyze": "ANALYZE=true next build --webpack"
  },
  "dependencies": {
    "expressive-code": "^0.44.2",
    "lottie-react": "^3.1.2",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
